{
  "info": {
    "_postman_id": "quran-werd-api-collection",
    "name": "Quran Werd API",
    "description": "API collection for Quran Werd Server - Authentication, Memorization, and Revision Plan endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Google Sign-In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has token and user\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('token');",
                  "    pm.expect(jsonData.data).to.have.property('user');",
                  "    ",
                  "    // Save the JWT to both environment and collection variables",
                  "    if (pm.environment.has('accessToken')) {",
                  "        pm.environment.set('accessToken', jsonData.data.token);",
                  "    }",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.token);",
                  "    ",
                  "    console.log('✅ Token saved successfully');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"idToken\": \"{{idToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": ["{{base_url}}"],
              "path": ["auth", "google"]
            },
            "description": "Sign in (or sign up) with a Google ID token. `idToken` normally must come from a Google Sign-In client SDK (web/mobile) - Postman can't mint one itself. For local/dev testing, the server accepts a `mock:<base64 json>` idToken instead (the default value of the `idToken` variable decodes to `{\"googleId\":\"dev-1\",\"email\":\"dev@example.com\",\"name\":\"Dev User\"}`) - it must be base64, not raw JSON, since Postman substitutes {{idToken}} into this raw JSON body unescaped and literal quotes would break it. Requires the server to have `AUTH_MOCK_GOOGLE=true` set - never enable that in production. Creates the user on first sign-in, or updates name/email if they changed. Returns a single JWT (`data.token`); there is no separate refresh token / refresh endpoint."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has user fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('_id');",
                  "    pm.expect(jsonData.data).to.have.property('email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Get the authenticated user's profile (_id, name, email, createdAt)"
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Logout successful\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    ",
                  "    // Clear the token from both environment and collection variables",
                  "    if (pm.environment.has('accessToken')) {",
                  "        pm.environment.unset('accessToken');",
                  "    }",
                  "    pm.collectionVariables.unset('accessToken');",
                  "    ",
                  "    console.log('✅ Logged out - token cleared');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Logout. The JWT itself isn't server-side invalidated (no refresh token to revoke) - this just confirms the call and the collection clears its stored copy."
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints - Google Sign-In only. There is no phone/OTP login and no refresh-token flow in this API."
    },
    {
      "name": "Memorizations",
      "item": [
        {
          "name": "Get All Memorizations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has ranges\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('ranges');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/memorizations",
              "host": ["{{base_url}}"],
              "path": ["memorizations"]
            },
            "description": "Get all memorized ranges for the authenticated user, grouped by surah (data.ranges: Record<surah, Range[]>)"
          },
          "response": []
        },
        {
          "name": "Add Memorization Ranges",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has ranges, results, changed, and planRegenerated\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.data).to.have.property('ranges');",
                  "    pm.expect(jsonData.data).to.have.property('results');",
                  "    pm.expect(jsonData.data).to.have.property('changed');",
                  "    pm.expect(jsonData.data).to.have.property('planRegenerated');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"ranges\": [\n        { \"surah\": 1, \"from\": 1, \"to\": 7 },\n        { \"surah\": 2, \"from\": 1, \"to\": 10 }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/memorizations/ranges",
              "host": ["{{base_url}}"],
              "path": ["memorizations", "ranges"]
            },
            "description": "Add one or more memorized ayah ranges in a single request. Each item carries its own surah, so a batch can span multiple surahs. Overlapping/adjacent ranges (within the batch or against existing ones) are merged automatically. Validation is all-or-nothing: if any item is invalid, no changes are saved. `changed` reflects whether the batch actually expanded total memorized ayah coverage (resubmitting already-covered ranges yields `changed: false`, even if some items report `merged: true`). If coverage expanded and the user has a revision plan, the plan's `incompleteAwrad` is automatically regenerated to include the newly memorized ayahs (`planRegenerated: true`); users with no plan yet, or batches that added no new coverage, leave the plan untouched.\n\nResponse: `{ data: { ranges }, results: [{ surah, from, to, merged }], changed: boolean, planRegenerated: boolean }`."
          },
          "response": []
        },
        {
          "name": "Delete Memorization Range",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has ranges, changed, and planRegenerated\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('ranges');",
                  "    pm.expect(jsonData).to.have.property('changed');",
                  "    pm.expect(jsonData).to.have.property('planRegenerated');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/memorizations/range/:surah/:from/:to",
              "host": ["{{base_url}}"],
              "path": ["memorizations", "range", ":surah", ":from", ":to"],
              "variable": [
                {
                  "key": "surah",
                  "value": "1",
                  "description": "Surah number (1-114)"
                },
                {
                  "key": "from",
                  "value": "4",
                  "description": "First ayah to remove from memorization (need not match a stored range's boundary)"
                },
                {
                  "key": "to",
                  "value": "5",
                  "description": "Last ayah to remove from memorization (need not match a stored range's boundary)"
                }
              ]
            },
            "description": "Subtracts the given ayah range from whatever is currently memorized for that surah. Splits a stored range into two if the deletion falls in the middle of it (e.g. deleting 4-5 from a stored 1-7 range leaves 1-3 and 6-7), trims an edge, or removes ranges entirely - across all stored ranges for that surah that overlap. Ayahs outside anything stored are ignored rather than erroring. If nothing overlaps (including when no memorization exists yet for the user), this succeeds as a no-op with `changed: false`. If the deletion overlaps a wird still in the user's incomplete revision-plan queue, the plan's `incompleteAwrad` is automatically regenerated (`planRegenerated: true`); deletions touching only already-completed awrad, or no plan at all, leave the plan untouched.\n\nResponse: `{ data: { ranges }, changed: boolean, planRegenerated: boolean }`."
          },
          "response": []
        }
      ],
      "description": "Memorization endpoints - requires authentication"
    },
    {
      "name": "Revision Plan",
      "item": [
        {
          "name": "Get Revision Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has both awrad lists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('incompleteAwrad');",
                  "    pm.expect(jsonData.data).to.have.property('completedAwrad');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/revision-plan",
              "host": ["{{base_url}}"],
              "path": ["revision-plan"]
            },
            "description": "Get the authenticated user's revision plan (dailyCapacity, incompleteAwrad, completedAwrad)"
          },
          "response": []
        },
        {
          "name": "Generate Revision Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Plan generated with empty completedAwrad\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.incompleteAwrad).to.be.an('array');",
                  "    pm.expect(jsonData.data.completedAwrad).to.have.lengthOf(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"dailyCapacity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/revision-plan/generate",
              "host": ["{{base_url}}"],
              "path": ["revision-plan", "generate"]
            },
            "description": "(Re)build the plan from scratch from all currently memorized ranges: wipes completedAwrad and rebuilds incompleteAwrad. dailyCapacity is a number of Mushaf pages per werd (1, 2, 3, ...), not ayat. Also the action used to start the next cycle after the plan is 'finished'."
          },
          "response": []
        },
        {
          "name": "Update Daily Capacity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Capacity updated, completedAwrad preserved\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.dailyCapacity).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"dailyCapacity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/revision-plan/capacity",
              "host": ["{{base_url}}"],
              "path": ["revision-plan", "capacity"]
            },
            "description": "Change dailyCapacity mid-cycle. completedAwrad is left untouched; incompleteAwrad is rebuilt only from the ranges not yet completed this cycle."
          },
          "response": []
        },
        {
          "name": "Get Current Werd",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has current, next and planStatus\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('current');",
                  "    pm.expect(jsonData.data).to.have.property('next');",
                  "    pm.expect(jsonData.data).to.have.property('planStatus');",
                  "    pm.expect(['active', 'finished', 'no-plan']).to.include(jsonData.data.planStatus);",
                  "",
                  "    // Save current werd id for the Complete Werd request",
                  "    if (jsonData.data.current && jsonData.data.current.werd && jsonData.data.current.werd._id) {",
                  "        pm.collectionVariables.set('werdId', jsonData.data.current.werd._id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/revision-plan/current",
              "host": ["{{base_url}}"],
              "path": ["revision-plan", "current"]
            },
            "description": "Get the current and next werd, derived from the plan (no separate revision log). `current` is the last completedAwrad entry if it was completed today (isCompleted: true), otherwise the front of incompleteAwrad (isCompleted: false); null if the plan is finished and nothing was completed today. `next` is whichever werd would become current once the present one is claimed - always null if there's nothing left to hand out. `planStatus` is 'active', 'finished' (incompleteAwrad is empty, regardless of when the last werd was completed - call Generate Revision Plan to start the next cycle), or 'no-plan'."
          },
          "response": []
        },
        {
          "name": "Complete Werd",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Werd marked completed\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('completed');",
                  "    pm.expect(jsonData.data).to.have.property('werd');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"werdId\": \"{{werdId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/revision-plan/complete",
              "host": ["{{base_url}}"],
              "path": ["revision-plan", "complete"]
            },
            "description": "Complete the werd at the front of incompleteAwrad. werdId is a guard (must match the current front werd, from Get Current Werd) - a repeat call with the same werdId after it's already completed is a safe no-op, it won't complete a second werd."
          },
          "response": []
        }
      ],
      "description": "Revision plan endpoints - requires authentication. dailyCapacity is in Mushaf pages. Cycling through a plan never auto-recycles: once incompleteAwrad is empty, status is 'finished' until you explicitly call Generate Revision Plan again."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set Authorization header for authenticated requests",
          "if (pm.request.auth && pm.request.auth.type === 'bearer') {",
          "    // Try to get token from environment first, then collection variables",
          "    let token = pm.environment.get('accessToken');",
          "    if (!token) {",
          "        token = pm.collectionVariables.get('accessToken');",
          "    }",
          "    if (token) {",
          "        pm.request.headers.add({",
          "            key: 'Authorization',",
          "            value: `Bearer ${token}`",
          "        });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "idToken",
      "value": "mock:eyJnb29nbGVJZCI6ICJkZXYtMSIsICJlbWFpbCI6ICJkZXZAZXhhbXBsZS5jb20iLCAibmFtZSI6ICJEZXYgVXNlciJ9",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "werdId",
      "value": "",
      "type": "string"
    }
  ]
}
