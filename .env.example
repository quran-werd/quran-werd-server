GOOGLE_CLIENT_ID=
JWT_SECRET=
MONGODB_URI=
PORT=3000

# Only needed to (re)generate src/data/quranMaps.mushaf2.cache.json — once that
# file exists, the server loads from it and these aren't required.
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
# Defaults to the prelive environment (apis-prelive.quran.foundation /
# prelive-oauth2.quran.foundation). Override when switching to production:
# QURAN_FOUNDATION_GATEWAY_URL=https://apis.quran.foundation
# QURAN_FOUNDATION_OAUTH2_URL=https://oauth2.quran.foundation
QURAN_FOUNDATION_GATEWAY_URL=
QURAN_FOUNDATION_OAUTH2_URL=
